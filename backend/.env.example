# ResQNet Backend Environment Configuration
# Copy this file to .env and provide your actual Neo4j AuraDB credentials:
# Example: cp .env.example .env

PORT=5000

# Neo4j AuraDB Connection
# Typically begins with neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Neo4j Database name (typically "neo4j" for AuraDB default)
NEO4J_DATABASE=neo4j

# Stock threshold below which an inventory item is flagged as Low Stock
LOW_STOCK_THRESHOLD=25
